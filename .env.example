# Generate both values on the setup page (https://<your-deployment>/setup or `pnpm setup-token encrypt config.json`).
MAILMCP_CONFIG=
MAILMCP_KEY=
# License key (Personal €19 / Unlimited €149), see /pricing. Leave empty for the free tier: up to 2 mailboxes and a
# "Sent with mailmcp.ai" signature in every message the assistant composes.
MAILMCP_LICENSE=
# Required on a server that issues user tokens: only people who know this code (8+ characters) can create a token on /setup.
# Lost it? Read it in your Vercel/Docker environment, or set a new one and redeploy; existing tokens keep working.
MAILMCP_INVITE_CODE=
# Public server (the vendor's mailmcp.ai): anyone may create tokens. Do not set this on a private server.
# MAILMCP_OPEN_SIGNUP=1
# Optional: your own Entra app registration for the Microsoft sign-in (default: the vendor's public client id).
# Needed for work accounts in most Microsoft 365 tenants (they block the code sign-in); how to register it:
# README, "Work accounts on your own server".
# MAILMCP_MS_CLIENT_ID=
# Set this only when THIS origin is registered as a redirect URI in the Entra app above: the setup page then signs in
# through a popup instead of relaying a Microsoft device code.
# MAILMCP_MS_REDIRECT=1
# Switch the Microsoft sign-in off entirely (the setup page offers passwords only)
# MAILMCP_MS_DISABLED=1
# Refuse Outlook/Microsoft 365 mailboxes at runtime, including in tokens already issued
# MAILMCP_DISABLE_GRAPH=1
# Claude Desktop build only: stop asking GitHub for the latest release on every start
# MAILMCP_NO_UPDATE_CHECK=1
# Force the signature on a licensed server (the vendor's demo server does this)
# MAILMCP_SIGNATURE=1
# Optional checkout links shown on /pricing
# MAILMCP_BUY_PERSONAL_URL=
# MAILMCP_BUY_UNLIMITED_URL=
# MAILMCP_BUY_DEPLOYMENT_URL=
# Optional: embed URL (YouTube/Vimeo) of the install video shown on the home page
# MAILMCP_VIDEO_URL=
# Optional: trust X-Forwarded-* headers behind your own reverse proxy (on Vercel they are trusted automatically)
# MAILMCP_TRUST_PROXY=1
# Optional: let user tokens point at private/intranet mail hosts. Off by default: hosts in user tokens are resolved and private,
# loopback, link-local and CGNAT addresses are refused so a public server cannot be used to probe its own network.
# Set to 1 only on a deployment inside your own network whose mail server has a private address. The owner config is exempt.
# MAILMCP_ALLOW_PRIVATE_MAIL_HOSTS=1
# Optional: domain-verification token from the OpenAI plugin submission portal (served at /.well-known/openai-apps-challenge).
# OPENAI_APPS_CHALLENGE=
# Optional: Vercel Web Analytics for THIS deployment only. Enable Analytics on your Vercel project, then paste the script
# path the dashboard shows (usually /_vercel/insights/script.js). Reports to your own project; never to the vendor.
# MAILMCP_ANALYTICS_SCRIPT=/_vercel/insights/script.js
# Optional: force the public URL used in OAuth metadata (otherwise derived from the request).
# MAILMCP_PUBLIC_URL=https://mailmcp-yourname.vercel.app

# --- Stripe (only on the server that sells licences; Managed Payments = Stripe is the merchant of record) ---
# Ed25519 private key (pkcs8, base64url) that signs mailmcp keys; keep it secret
# MAILMCP_LICENSE_PRIVKEY=
# Live secret key and the price ids created by `node scripts/stripe-setup.mjs`
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_PERSONAL=price_...
# STRIPE_PRICE_UNLIMITED=price_...
# Signing secret of the webhook endpoint /api/stripe/webhook (checkout.session.completed)
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: e-mail the mailmcp key right after purchase
# LICENSE_SMTP_URL=smtps://resend:re_...@smtp.resend.com:465
# LICENSE_REPLY_TO=info@example.com
# LICENSE_MAIL_FROM="mailmcp <licence@jiridolejs.cz>"
