# Generate both values on the setup page (https://<your-deployment>/setup or `pnpm setup-token encrypt config.json`).
MAILMCP_CONFIG=
MAILMCP_KEY=
# License key (Personal €4.99 / Unlimited €129), see /pricing
MAILMCP_LICENSE=
# Optional checkout links shown on /pricing
# MAILMCP_BUY_PERSONAL_URL=
# MAILMCP_BUY_UNLIMITED_URL=
# MAILMCP_BUY_DEPLOYMENT_URL=
# Optional: closed registration of user tokens on a shared server
# MAILMCP_INVITE_CODE=
# Optional: embed URL (YouTube/Vimeo) of the install video shown on the home page
# MAILMCP_VIDEO_URL=
# Optional: trust X-Forwarded-* headers behind your own reverse proxy (on Vercel they are trusted automatically)
# MAILMCP_TRUST_PROXY=1
# Optional: let user tokens point at private/intranet mail hosts (off on public servers)
# MAILMCP_ALLOW_PRIVATE_MAIL_HOSTS=1
# Optional: force the public URL used in OAuth metadata (otherwise derived from the request).
# MAILMCP_PUBLIC_URL=https://mailmcp-yourname.vercel.app

# --- Lemon Squeezy (only on the server that sells licenses) ---
# Ed25519 private key (pkcs8, base64url) that signs mailmcp keys; keep it secret
# MAILMCP_LICENSE_PRIVKEY=
# LS variant ids of the two products
# LEMONSQUEEZY_VARIANT_PERSONAL=
# LEMONSQUEEZY_VARIANT_UNLIMITED=
# Optional: refuse keys from any other Lemon Squeezy store
# LEMONSQUEEZY_STORE_ID=
# LS webhook signing secret (event: license_key_created)
# LEMONSQUEEZY_WEBHOOK_SECRET=
# Optional: e-mail the mailmcp key right after purchase
# LICENSE_SMTP_URL=smtps://user:app-password@smtp.gmail.com:465
# LICENSE_MAIL_FROM="mailmcp <licence@jiridolejs.cz>"
